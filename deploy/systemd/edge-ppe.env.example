# EdgePPE Lab API environment, installed as /etc/edge-ppe/edge-ppe.env.
# Paths are absolute because the unit does not inherit an interactive shell.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
EDGE_PPE_MODEL_NAME=edge-ppe-detector
EDGE_PPE_MODEL_ALIAS=champion
EDGE_PPE_CONFIDENCE=0.25
EDGE_PPE_IOU_THRESHOLD=0.45
EDGE_PPE_MODEL_CACHE=/home/shiva_kushwah/projects/edge-ppe-lab/var/model-cache
EDGE_PPE_STARTUP_STRICT=true
