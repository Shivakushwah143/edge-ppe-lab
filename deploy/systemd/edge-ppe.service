[Unit]
Description=EdgePPE Lab ONNX Inference API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgeppe
Group=edgeppe
WorkingDirectory=/opt/edge-ppe-lab
EnvironmentFile=/etc/edge-ppe/edge-ppe.env
ExecStart=/opt/edge-ppe-lab/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/edge-ppe-lab/var

[Install]
WantedBy=multi-user.target
